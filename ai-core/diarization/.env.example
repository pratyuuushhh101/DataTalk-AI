"""
.env configuration for Diarization Microservice
"""
# Azure Speech Service (same keys as your main ai-core)
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=centralindia

# Server Config
DIARIZATION_PORT=8100

# Hugging Face Token (required for pyannote.audio models)
# Get from: https://huggingface.co/settings/tokens
# Accept pyannote terms: https://huggingface.co/pyannote/speaker-diarization-3.1
HF_TOKEN=
